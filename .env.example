# ── Database (PostgreSQL via Prisma — Supabase) ──────────────────────────
# Create a free project at https://supabase.com, then in the project's
# "Connect" dialog → ORM → Prisma, copy both connection strings below.
# DATABASE_URL: transaction-mode pooler, used at runtime.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: session-mode pooler, used only for `prisma db push`/migrations.
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ── Stripe (test mode — plan checkout on the Pricing page) ──────────────
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` (local)
# or the webhook's signing secret in the Stripe dashboard (deployed).
STRIPE_WEBHOOK_SECRET=""

# ── Email (Resend — lead/testimonial notifications + confirmations) ─────
# https://resend.com/api-keys — leave blank in dev to log emails to console instead.
RESEND_API_KEY=""
EMAIL_FROM="Nemora <onboarding@resend.dev>"
TEAM_NOTIFICATION_EMAIL="nemorastudios@gmail.com"

# ── Rate limiting (Upstash Redis — optional) ─────────────────────────────
# Leave blank to use the in-memory fallback limiter (fine for local dev,
# NOT safe for a multi-instance production deployment).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Live Demo escalation ──────────────────────────────────────────────
# Real business WhatsApp number (digits only, country code, no "+" or
# spaces — e.g. "919876543210") shown as a wa.me link whenever a demo
# panel can't match a scripted answer. Leave blank to only show "Book a
# call" (/contact) in that case — no fictional number is ever fabricated.
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# ── Feature flags — real third-party sends are OFF by default ───────────
# Flip to "true" only once real WhatsApp Business API (Twilio) credentials
# are wired into src/components/demo/WhatsappPanel.tsx.
ENABLE_WHATSAPP_SEND="false"
NEXT_PUBLIC_ENABLE_WHATSAPP_SEND="false"
# Flip to "true" only once real outbound email sending (Gmail API) is wired
# into src/components/demo/EmailPanel.tsx's "Send reply" action.
ENABLE_EMAIL_SEND="false"

# ── Misc ──────────────────────────────────────────────────────────────
# Used to build absolute Stripe redirect URLs; set to your deployed origin in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
